{
	"compatibility_date": "2026-04-30",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "self-page",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Custom Domains: Cloudflare creates the DNS records and the SSL
	// certificate for these hostnames on deploy (zone must be in this account).
	"routes": [
		{ "pattern": "morganoms.dev", "custom_domain": true },
		{ "pattern": "www.morganoms.dev", "custom_domain": true }
	]
}