---
export const prerender = true;
import BlogPostRoute from "@/routes/BlogPostRoute.astro";
import { getPostPaths } from "@/lib/blog";
import { DEFAULT_LOCALE } from "@/i18n/config";

export async function getStaticPaths() {
  return getPostPaths(DEFAULT_LOCALE);
}

const { post, previousPost, nextPost } = Astro.props;
---

<BlogPostRoute locale={DEFAULT_LOCALE} post={post} previousPost={previousPost} nextPost={nextPost} />
