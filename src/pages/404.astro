---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { Home } from "lucide-react";
import { DEFAULT_LOCALE, LOCALES, localizePath } from "@/i18n/config";
import { UI } from "@/i18n/ui";

// There is a single 404 page for every language, so it ships the three
// translations and picks one in the browser based on the URL prefix.
const messages = Object.fromEntries(
  LOCALES.map((locale) => [
    locale,
    {
      title: UI[locale]["notFound.title"],
      text: UI[locale]["notFound.text"],
      home: UI[locale]["notFound.home"],
      homeHref: localizePath("/", locale),
    },
  ]),
);
---

<Layout locale={DEFAULT_LOCALE} title={`404 - ${messages.en.title}`}>
  <div class="min-h-[calc(100vh-12rem)] flex flex-col">
    <div class="flex-1 flex items-center justify-center p-8">
      <div class="flex flex-col items-center text-center max-w-md relative">
        <h1 class="text-[200px] font-semibold font-mono bg-linear-to-b from-primary/30 to-secondary/10 text-transparent bg-clip-text absolute -top-40 left-1/2 -translate-x-1/2 mask-[linear-gradient(to_bottom,black,black_20%,transparent_80%)] tracking-tighter uppercase [-webkit-text-stroke:3px_hsl(var(--primary)/0.6)]">
          404
        </h1>
        <h2 data-404="title" class="text-4xl tracking-tight font-semibold text-foreground mb-2">
          {messages.en.title}
        </h2>
        <p data-404="text" class="text-muted-foreground mb-8 text-balance tracking-tight font-medium">
          {messages.en.text}
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a data-404="homeHref" href={messages.en.homeHref}>
            <span class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2 cursor-pointer">
              <Home className="h-4 w-4" />
              <span data-404="home">{messages.en.home}</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
  <script is:inline define:vars={{ messages, locales: LOCALES }}>
    const prefix = location.pathname.split("/").filter(Boolean)[0];
    const locale = locales.includes(prefix) ? prefix : "en";
    const m = messages[locale];
    if (m && locale !== "en") {
      document.documentElement.lang = locale === "pt-br" ? "pt-BR" : locale;
      document.querySelectorAll("[data-404]").forEach((el) => {
        const key = el.getAttribute("data-404");
        if (key === "homeHref") el.setAttribute("href", m.homeHref);
        else el.textContent = m[key];
      });
      document.title = "404 - " + m.title;
    }
  </script>
</Layout>
